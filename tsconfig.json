{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react",
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "react"
    ]
  },
  "include": [
    "src",
    "tests"
  ],
  "exclude": [
    "tests/integration.sit.test.ts"
  ]
}
